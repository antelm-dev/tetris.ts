# Copy this file to `.env` before running `docker compose up --build`.
# Generate a unique value, for example with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

WEB_PORT=4000
API_PORT=3000

# Set this to the public origin serving the web game when deployed.
CORS_ORIGINS=http://localhost:4000

# Keep development until the API has a persistent UserRepository. The API
# intentionally refuses to boot in production with its current in-memory store.
API_NODE_ENV=development

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WS_NAMESPACE=/game
ROOM_MAX_PLAYERS=100

