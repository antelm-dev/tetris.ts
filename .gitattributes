# Normalize all text files to LF in the repository.
# Prevents Windows checkouts (core.autocrlf=true) from committing CRLF blobs,
# which would break `oxfmt --check` and the LF-dependent husky/sh hooks in CI.
* text=auto eol=lf

# Shell / git hooks must stay LF regardless of platform.
*.sh text eol=lf
.husky/** text eol=lf

# Binary assets — never touch line endings.
*.ogg binary
*.png binary
*.gif binary
