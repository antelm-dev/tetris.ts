{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "warn" },
  "env": { "builtin": true, "es2022": true },
  "rules": {
    "typescript/consistent-type-imports": "warn",
    "typescript/no-explicit-any": "warn",
    "unicorn/prefer-node-protocol": "error",

    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "promise/always-return": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-new-array": "off",
    "unicorn/require-module-specifiers": "off"
  },
  "ignorePatterns": [
    "apps/tetris/main/generated",
    "dist-main",
    "dist-renderer",
    "dist-web",
    "release",
    "apps/tetris/server/data"
  ],
  "overrides": [
    {
      "files": [
        "apps/tetris/main/**/*.ts",
        "apps/tetris/scripts/**/*.mjs",
        "apps/tetris/server/**/*.mjs",
        "*.config.*",
        "apps/tetris/test/**/*.ts"
      ],
      "env": { "node": true }
    },
    { "files": ["apps/tetris/renderer/**/*.ts"], "env": { "browser": true } },
    {
      "files": ["apps/tetris/server/**/*.mjs"],
      "rules": {
        "promise/no-callback-in-promise": ["error", { "exceptions": ["next"] }]
      }
    },
    { "files": ["**/*.d.ts"], "rules": { "typescript/consistent-type-imports": "off" } },
    {
      "files": ["apps/tetris/test/**/*.ts"],
      "plugins": ["vitest"],
      "env": { "vitest": true },
      "rules": {
        "typescript/no-explicit-any": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/valid-expect": "off"
      }
    }
  ]
}
