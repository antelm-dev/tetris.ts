# Copy to `.env` and adjust. Never commit a real `.env` — secrets stay local.
# Validated at boot by src/config/env.schema.ts; the process refuses to start
# if anything here is missing or malformed.

# development | test | production
NODE_ENV=development

# Verbosity threshold: fatal | error | warn | log | debug | verbose.
# Each level also enables the less verbose ones above it. `debug` adds socket
# lifecycle and auth-guard detail; `verbose` adds per-delivery gameplay logs.
LOG_LEVEL=log

# HTTP server bind address and port. REST routes are served under /api.
API_HOST=0.0.0.0
API_PORT=3000

# Comma-separated allowed CORS origins, or `*` for any, or empty to disable.
# Example for the web + Electron dev clients:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT signing secret (min 16 chars). Generate a strong random value per env,
# e.g. `openssl rand -base64 48`. The value below is a placeholder, NOT a secret.
JWT_SECRET=change-me-in-your-local-env-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Realtime gateway namespace and the server-wide cap on players per room.
WS_NAMESPACE=/game
ROOM_MAX_PLAYERS=100
