{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    // Workspace packages resolve through node_modules and their package
    // exports; do not add source-path aliases here because Nest's SWC emit
    // preserves those paths in dist/, where they are no longer relative.
    "paths": {}
  },
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "vitest.config.ts"]
}
