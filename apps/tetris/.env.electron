# Electron target env (loaded by Vite for `--mode electron`).
# Any key here is exposed to the renderer as `import.meta.env.<KEY>`.
VITE_BASE=/

# Online Versus (Phase 2) — default OFF.
# Copy `.env.electron.local.example` → `.env.electron.local` (gitignored) to enable:
#   VITE_ONLINE_MULTIPLAYER_UI=1
#   VITE_API_ORIGIN=http://localhost:3000
# VITE_ONLINE_MULTIPLAYER_UI=1
# VITE_API_ORIGIN=http://localhost:3000
