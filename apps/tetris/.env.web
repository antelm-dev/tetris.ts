# Web target env (loaded by Vite for the default / `web` mode).
# Any key here is exposed to the renderer as `import.meta.env.<KEY>`.
# Override VITE_BASE if the web build is deployed under a sub-path.
VITE_BASE=/

# Online Versus (Phase 2) — default OFF.
# Copy `.env.web.local.example` → `.env.web.local` (gitignored) to enable locally:
#   VITE_ONLINE_MULTIPLAYER_UI=1
#   VITE_API_ORIGIN=http://localhost:3000
# Leave VITE_API_ORIGIN empty for same-origin only — the Vite `/api` proxy serves
# Solo records, not Nest auth.
 VITE_ONLINE_MULTIPLAYER_UI=1
 VITE_API_ORIGIN=http://localhost:3000
