# Web target env (loaded by Vite for the default mode).
# Any key here is exposed to the renderer as `import.meta.env.<KEY>`.
# Override VITE_BASE if the web build is deployed under a sub-path.
VITE_BASE=/

# Online Versus (Phase 2). Set to 1 to show the Online Versus menu route.
# Point VITE_API_ORIGIN at the Nest Phase 1 API (default port 3000). Leave empty
# for same-origin only — the Vite `/api` proxy serves Solo records, not Nest auth.
VITE_ONLINE_MULTIPLAYER_UI=1
# VITE_API_ORIGIN=http://localhost:3000
