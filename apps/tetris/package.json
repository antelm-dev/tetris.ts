{
  "name": "tetris.ts",
  "version": "1.0.0",
  "description": "Tetris in TypeScript on Electron",
  "keywords": [],
  "homepage": "https://github.com/antelm-dev/tetris.ts#readme",
  "bugs": {
    "url": "https://github.com/antelm-dev/tetris.ts/issues"
  },
  "license": "MIT",
  "author": "Adel Terki <adel.terki2@outlook.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antelm-dev/tetris.ts.git"
  },
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "gen:ipc": "node scripts/gen-ipc.mjs",
    "dev": "concurrently -k -n vite,rollup -c blue,magenta \"vite --mode electron\" \"rollup -c --environment NODE_ENV:development --watch\"",
    "dev:web": "concurrently -k -n vite,server -c blue,green \"vite --mode web\" \"node server/index.mjs\"",
    "build:renderer": "vite build --mode electron",
    "build:renderer:web": "vite build --mode web",
    "build:main": "rollup -c --environment NODE_ENV:production",
    "build": "pnpm clean && pnpm typecheck && pnpm build:renderer && pnpm build:main",
    "build:web": "pnpm clean && pnpm gen:ipc && pnpm typecheck:renderer && pnpm build:renderer:web",
    "start": "electron .",
    "preview": "pnpm build && electron .",
    "serve:web": "node server/index.mjs",
    "preview:web": "pnpm build:web && pnpm serve:web",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck": "pnpm gen:ipc && pnpm typecheck:main && pnpm typecheck:preload && pnpm typecheck:renderer",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dir": "pnpm build && electron-builder --dir",
    "pack:win": "pnpm build && electron-builder --win --dir",
    "pack:mac": "pnpm build && electron-builder --mac --dir",
    "pack:linux": "pnpm build && electron-builder --linux --dir",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@tetris/bot": "workspace:*",
    "@tetris/engine": "workspace:*",
    "@tetris/records": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.8.6",
    "@types/p5": "^1.7.6",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "electron": "^40.8.0",
    "electron-builder": "^26.0.12",
    "electron-ipc-module": "github:antelm-dev/electron-ipc-module#main",
    "electron-run": "github:antelm-dev/electron-run#master",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "p5": "^1.11.3",
    "rollup": "^4.30.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.9"
  },
  "desktopName": "com.adelterki.tetris.desktop"
}
