{
  "name": "tetris.ts-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tetris in TypeScript on Electron — pnpm monorepo",
  "homepage": "https://github.com/antelm-dev/tetris.ts#readme",
  "license": "MIT",
  "author": "Adel Terki <adel.terki2@outlook.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antelm-dev/tetris.ts.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/tetris dev",
    "dev:web": "pnpm -C apps/tetris dev:web",
    "dev:assets": "pnpm -C apps/asset-manager dev",
    "start": "pnpm -C apps/tetris start",
    "build": "pnpm -C apps/tetris build",
    "build:web": "pnpm -C apps/tetris build:web",
    "build:assets": "pnpm -C apps/asset-manager build",
    "preview": "pnpm -C apps/tetris preview",
    "preview:web": "pnpm -C apps/tetris preview:web",
    "serve:web": "pnpm -C apps/tetris serve:web",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm -C apps/api dev",
    "build:api": "pnpm -C apps/api build",
    "start:api": "pnpm -C apps/api start",
    "test:api": "pnpm -C apps/api test",
    "typecheck:api": "pnpm -C apps/api typecheck",
    "test": "pnpm -C apps/tetris test",
    "test:assets": "pnpm -C apps/asset-manager test",
    "test:watch": "pnpm -C apps/tetris test:watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "pnpm -C apps/tetris clean",
    "dist": "pnpm -C apps/tetris dist",
    "dist:win": "pnpm -C apps/tetris dist:win",
    "dist:mac": "pnpm -C apps/tetris dist:mac",
    "dist:linux": "pnpm -C apps/tetris dist:linux"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "esbuild": "0.27.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.28.2"
}
