{
  "name": "tetris.ts",
  "version": "1.0.0",
  "description": "Tetris in TypeScript on Electron",
  "license": "MIT",
  "author": "Adel Terki",
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "gen:ipc": "node scripts/gen-ipc.mjs",
    "dev": "concurrently -k -n vite,rollup -c blue,magenta \"vite\" \"rollup -c --environment NODE_ENV:development --watch\"",
    "build:renderer": "vite build",
    "build:main": "rollup -c --environment NODE_ENV:production",
    "build": "yarn clean && yarn gen:ipc && yarn typecheck && yarn build:renderer && yarn build:main",
    "start": "electron .",
    "preview": "yarn build && electron .",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck": "yarn gen:ipc && yarn typecheck:main && yarn typecheck:preload && yarn typecheck:renderer",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dir": "yarn build && electron-builder --dir",
    "dist": "yarn build && electron-builder",
    "dist:win": "yarn build && electron-builder --win",
    "dist:mac": "yarn build && electron-builder --mac",
    "dist:linux": "yarn build && electron-builder --linux"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.8.6",
    "@types/p5": "^1.7.6",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "electron": "^40.8.0",
    "electron-builder": "^26.0.12",
    "electron-ipc-module": "portal:../electron-libs/ipc-module",
    "electron-run": "portal:../electron-libs/electron-run",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "p5": "^1.11.3",
    "rollup": "^4.30.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.12.0"
}
